# copy to .env

DATABASE_URL=postgres://driftwood:driftwood@localhost:5432/driftwood_portal

# signs the portal session cookie
SESSION_SECRET=dev-session-secret

# driftwood-ops api, and the shared key its /portal/* routes expect.
# has to match PORTAL_API_KEY over there
OPS_API_URL=http://localhost:4000
OPS_PORTAL_API_KEY=dev-portal-key
